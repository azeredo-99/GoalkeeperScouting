# Copia este ficheiro para .env (nunca commitado -- ver .gitignore) e ajusta
# os valores conforme necessário. Os valores abaixo são apenas para
# desenvolvimento local via docker-compose; não os reutilizes em produção.

POSTGRES_USER=gk_scouting
POSTGRES_PASSWORD=changeme_local_dev_only
POSTGRES_DB=gk_scouting
POSTGRES_PORT=5432

# String de ligação usada pela aplicação/Alembic. Tem de refletir os valores
# acima (mesmo user/password/db/porta).
DATABASE_URL=postgresql+psycopg2://gk_scouting:changeme_local_dev_only@localhost:5432/gk_scouting
